# Paths are relative to the project root unless absolute.
VISUAL_SEARCH_DATA_DIR=data/images
VISUAL_SEARCH_ARTIFACT_DIR=artifacts
VISUAL_SEARCH_DB_PATH=artifacts/visual_search.sqlite3
VISUAL_SEARCH_DEVICE=auto
VISUAL_SEARCH_ENCODER=resnet50
VISUAL_SEARCH_INDEX_BACKEND=sklearn
VISUAL_SEARCH_DEEP_WEIGHT=0.75
VISUAL_SEARCH_COLOR_WEIGHT=0.15
VISUAL_SEARCH_TEXTURE_WEIGHT=0.10
VISUAL_SEARCH_MAX_UPLOAD_MB=15

VISUAL_SEARCH_METRIC_CHECKPOINT=
VISUAL_SEARCH_CLIP_MODEL=openai/clip-vit-base-patch32
